{
  "name": "starter-squad-c-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Squad C · Insight starter · AI-augmented PDLC hackathon (fictional payment reminders case)",
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "squad": "squad-c-insight",
    "port": 3003,
    "flag": "reminders_pilot_kpi"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit test/legacy",
    "test:reference": "vitest run test/reference",
    "test:coverage": "vitest run --coverage",
    "scan": "node scripts/scan-secrets.mjs",
    "context": "node scripts/nexus.mjs context-assemble --squad squad-c-insight --pull --out .context/brief.md",
    "publish": "node scripts/nexus.mjs publish",
    "contract-diff": "node scripts/nexus.mjs contract-diff --squad squad-c-insight",
    "flag": "node scripts/flag.mjs",
    "deploy": "node scripts/deploy.mjs",
    "observe": "node scripts/observe.mjs",
    "gate": "node scripts/gate.mjs",
    "harness-demo": "node scripts/harness-demo.mjs",
    "deprecated": "node scripts/deprecated.mjs",
    "spec:publish": "node scripts/spec.mjs publish",
    "spec:pull": "node scripts/spec.mjs pull",
    "graph": "graphify extract . --code-only && graphify cluster-only . --no-label"
  },
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
